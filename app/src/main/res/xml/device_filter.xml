<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 
    USB device filters for common USB-to-Serial adapters.
    This allows the app to automatically open when a compatible device is connected.
    
    The vendor and product IDs listed below cover common USB to serial converters:
    - FTDI
    - Prolific
    - Silicon Labs
    - Microchip
    - Cypress/Texas Instruments
    - QinHeng/CH34x
    -->
    
    <!-- FTDI FT232, FT2232, etc -->
    <usb-device vendor-id="1027" product-id="24577" /> <!-- 0x0403 0x6001 FT232 -->
    <usb-device vendor-id="1027" product-id="24592" /> <!-- 0x0403 0x6010 FT2232 -->
    <usb-device vendor-id="1027" product-id="24593" /> <!-- 0x0403 0x6011 FT4232 -->
    <usb-device vendor-id="1027" product-id="24596" /> <!-- 0x0403 0x6014 FT232H -->
    <usb-device vendor-id="1027" product-id="24597" /> <!-- 0x0403 0x6015 FT X-Series -->
    
    <!-- Prolific PL2303 -->
    <usb-device vendor-id="1659" product-id="8963" /> <!-- 0x067B 0x2303 PL2303 -->
    
    <!-- Silicon Labs CP210x -->
    <usb-device vendor-id="4292" product-id="60000" /> <!-- 0x10C4 0xEA60 CP210x -->
    
    <!-- Microchip/ATMEL products -->
    <usb-device vendor-id="1003" /> <!-- 0x03EB ATMEL -->
    
    <!-- CH340, CH341, etc -->
    <usb-device vendor-id="6790" product-id="29987" /> <!-- 0x1A86 0x7523 CH340 -->
    <usb-device vendor-id="6790" product-id="21795" /> <!-- 0x1A86 0x5523 CH341 -->
    <usb-device vendor-id="6790" product-id="21930" /> <!-- 0x1A86 0x55D4 CH340 -->
    
    <!-- Texas Instruments / TI / Stellaris -->
    <usb-device vendor-id="1105" product-id="62049" /> <!-- 0x0451 0xF432 -->
    
    <!-- Cypress -->
    <usb-device vendor-id="1204" /> <!-- 0x04B4 Cypress -->
</resources>
