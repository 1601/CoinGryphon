package com.example.coingryphon.serial;

import android.content.Context;
import android.util.Log;

import java.io.File;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.util.Arrays;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

// Using system libraries for terminal I/O control
import java.lang.reflect.Method;

/**
 * GryphonSerialManager handles the RS232 communication with the Gryphon device.
 * Communication parameters: 9600 baud rate, 1 start bit, 8 data bits, Mark parity bit, 1 stop bit
 * 
 * This implementation uses direct serial port access (/dev/ttys3).
 */
public class GryphonSerialManager {
    private static final String TAG = "GryphonSerialManager";
    
    // Serial port path
    private static final String SERIAL_PORT_PATH = "/dev/ttyS3";
    
    // Communication parameters - multiple options to try
    private static final int BAUD_RATE = 9600;
    private static final int DATA_BITS = 8;
    private static final int STOP_BITS = 1;
    
    // Two different parity options to try - some devices label "mark" differently
    private static final int PARITY_MARK = 3; // Standard mark parity (typically value 3)
    private static final int PARITY_ODD = 1;  // Some devices treat odd parity similar to mark
    private static final int TIMEOUT = 1000; // Read/write timeout in ms
    
    // Singleton instance
    private static GryphonSerialManager instance;
    
    private final Context context;
    private final ExecutorService executor;
    
    // Serial port connection
    private Object serialPort; // This will hold the SerialPort instance
    private InputStream inputStream;
    private OutputStream outputStream;
    private SerialPortReader portReader;
    private boolean readerRunning = false;
    
    private boolean isConnected = false;
    private GryphonSerialListener listener;
    
    /**
     * Interface for serial communication callbacks
     */
    public interface GryphonSerialListener {
        void onReceiveData(byte[] data);
        void onConnectionEstablished();
        void onConnectionLost();
        void onError(Exception e);
    }

    private GryphonSerialManager(Context context) {
        this.context = context;
        this.executor = Executors.newSingleThreadExecutor();
    }

    public static synchronized GryphonSerialManager getInstance(Context context) {
        if (instance == null) {
            instance = new GryphonSerialManager(context.getApplicationContext());
        }
        return instance;
    }
    
    public void setListener(GryphonSerialListener listener) {
        this.listener = listener;
    }

    /**
     * Connect to the serial port device (/dev/ttys3)
     */
    public boolean connectToDevice() {
        return openConnection();
    }
    
    /**
     * Open the serial connection with the specified parameters
     */
    private boolean openConnection() {
        try {
            // Create the serial port file
            File device = new File(SERIAL_PORT_PATH);
            
            if (!device.exists()) {
                Log.e(TAG, "Serial port " + SERIAL_PORT_PATH + " does not exist");
                return false;
            }
            
            // Try to set permissions directly - this may require root on some devices
            try {
                Process process = Runtime.getRuntime().exec("chmod 666 " + SERIAL_PORT_PATH);
                int result = process.waitFor();
                Log.d(TAG, "Attempted to set permissions for " + SERIAL_PORT_PATH + ", result: " + result);
            } catch (Exception e) {
                Log.w(TAG, "Could not set permissions directly: " + e.getMessage());
                // Continue anyway, as the device might already have correct permissions
            }
            
            // Use reflection to access the Android Serial Port API
            // This is the recommended way to access serial ports on Android
            // It properly handles setting baudrate, parity, etc.
            try {
                // Load the SerialPort class
                Class<?> SerialPortClass = Class.forName("android_serialport_api.SerialPort");
                
                // Get the constructor that takes a File and baudrate
                java.lang.reflect.Constructor<?> constructor = SerialPortClass.getConstructor(
                        File.class, int.class, int.class);
                
                // Create the SerialPort instance with the parameters
                // DATA_BITS, STOP_BITS and PARITY are combined into the 'flags' parameter
                // Format is typically: (DATABITS_8 | STOPBITS_1 | PARITY_MARK)
                int flags = (DATA_BITS | (STOP_BITS << 8) | (PARITY_MARK << 16));
                serialPort = constructor.newInstance(device, BAUD_RATE, flags);
                
                // Get the input and output streams
                Method getInputStreamMethod = SerialPortClass.getMethod("getInputStream");
                Method getOutputStreamMethod = SerialPortClass.getMethod("getOutputStream");
                
                inputStream = (InputStream) getInputStreamMethod.invoke(serialPort);
                outputStream = (OutputStream) getOutputStreamMethod.invoke(serialPort);
                
                Log.d(TAG, "Serial port opened with params: " + BAUD_RATE + " baud, " + 
                      DATA_BITS + " data bits, " + STOP_BITS + " stop bits, MARK parity");
            } catch (Exception e) {
                Log.e(TAG, "Error with serial port API, falling back to basic file I/O", e);
                
                // Fallback: Use basic file I/O (note: this won't configure baud rate, parity, etc.)
                // This is less ideal, as we can't set the serial parameters properly
                try {
                    // Try various serial port configuration options - RS232 can be finicky
                    
                    // Option 1: 9600 baud, 8N1 with mark parity (parenb parmrk)
                    String sttyCommand1 = "stty -F " + SERIAL_PORT_PATH + " " + 
                            BAUD_RATE + " cs8 -cstopb parenb parmrk -crtscts -ixon -ixoff raw";
                    
                    // Option 2: Same but with odd parity instead of mark (some devices interpret them similarly)
                    String sttyCommand2 = "stty -F " + SERIAL_PORT_PATH + " " + 
                            BAUD_RATE + " cs8 -cstopb parenb parodd -crtscts -ixon -ixoff raw";
                            
                    // Option 3: Try without any parity settings (some devices auto-detect)
                    String sttyCommand3 = "stty -F " + SERIAL_PORT_PATH + " " + 
                            BAUD_RATE + " cs8 -cstopb -parenb -crtscts -ixon -ixoff raw";
                    
                    // Try all options
                    Log.d(TAG, "Trying multiple serial configuration options");
                    
                    Process process1 = Runtime.getRuntime().exec(sttyCommand1);
                    int result1 = process1.waitFor();
                    Log.d(TAG, "Config option 1 result: " + result1);
                    
                    Process process2 = Runtime.getRuntime().exec(sttyCommand2);
                    int result2 = process2.waitFor();
                    Log.d(TAG, "Config option 2 result: " + result2);
                    
                    Process process3 = Runtime.getRuntime().exec(sttyCommand3);
                    int result3 = process3.waitFor();
                    Log.d(TAG, "Config option 3 result: " + result3);
                    
                    // Use the process and result from the last attempt for compatibility with rest of code
                    Process process = process3;
                    int result = result3;
                    
                    // Read any error output
                    StringBuilder errorOutput = new StringBuilder();
                    try (java.io.BufferedReader reader = new java.io.BufferedReader(
                            new java.io.InputStreamReader(process.getErrorStream()))) {
                        String line;
                        while ((line = reader.readLine()) != null) {
                            errorOutput.append(line).append("\n");
                        }
                    }
                    
                    if (result != 0 || errorOutput.length() > 0) {
                        Log.w(TAG, "stty command result: " + result + ", error: " + errorOutput);
                    } else {
                        Log.d(TAG, "Successfully configured serial port parameters");
                    }
                    
                    // Open streams using reflection to avoid direct file access restrictions
                    Class<?> FileInputStreamClass = Class.forName("java.io.FileInputStream");
                    Class<?> FileOutputStreamClass = Class.forName("java.io.FileOutputStream");
                    
                    java.lang.reflect.Constructor<?> fisConstructor = 
                            FileInputStreamClass.getConstructor(File.class);
                    java.lang.reflect.Constructor<?> fosConstructor = 
                            FileOutputStreamClass.getConstructor(File.class);
                    
                    inputStream = (InputStream) fisConstructor.newInstance(device);
                    outputStream = (OutputStream) fosConstructor.newInstance(device);
                    
                    Log.d(TAG, "Using basic file I/O for serial port");
                } catch (Exception ex) {
                    Log.e(TAG, "Failed to set serial parameters via stty", ex);
                    throw new IOException("Cannot configure serial port parameters");
                }
            }
            
            // Start the reader thread to handle incoming data
            portReader = new SerialPortReader();
            readerRunning = true;
            executor.submit(portReader);
            
            isConnected = true;
            if (listener != null) {
                listener.onConnectionEstablished();
            }
            
            Log.d(TAG, "Serial connection established with Gryphon at " + SERIAL_PORT_PATH);
            return true;
        } catch (Exception e) {
            Log.e(TAG, "Error opening serial connection", e);
            if (listener != null) {
                listener.onError(e);
            }
            closeConnection();
            return false;
        }
    }
    
    /**
     * Close the serial connection and cleanup resources
     */
    public void closeConnection() {
        isConnected = false;
        readerRunning = false;
        
        try {
            if (inputStream != null) {
                inputStream.close();
                inputStream = null;
            }
        } catch (IOException e) {
            Log.e(TAG, "Error closing input stream", e);
        }
        
        try {
            if (outputStream != null) {
                outputStream.close();
                outputStream = null;
            }
        } catch (IOException e) {
            Log.e(TAG, "Error closing output stream", e);
        }
        
        // Close the serial port if using the SerialPort API
        if (serialPort != null) {
            try {
                // Use reflection to call the close method
                Method closeMethod = serialPort.getClass().getMethod("close");
                closeMethod.invoke(serialPort);
            } catch (Exception e) {
                Log.e(TAG, "Error closing serial port", e);
            }
            serialPort = null;
        }
        
        Log.d(TAG, "Serial connection closed");
    }

    public boolean isConnected() {
        return isConnected;
    }
    
    /**
     * Send data to the Gryphon device
     * @param data byte array to send
     * @return true if data was sent successfully
     */
    public boolean sendData(byte[] data) {
            return false;
        }
        
        // Try to set permissions directly - this may require root on some devices
        try {
            Process process = Runtime.getRuntime().exec("chmod 666 " + SERIAL_PORT_PATH);
            int result = process.waitFor();
            Log.d(TAG, "Attempted to set permissions for " + SERIAL_PORT_PATH + ", result: " + result);
        } catch (Exception e) {
            Log.w(TAG, "Could not set permissions directly: " + e.getMessage());
            // Continue anyway, as the device might already have correct permissions
        }
        
        // Use reflection to access the Android Serial Port API
        // This is the recommended way to access serial ports on Android
        // It properly handles setting baudrate, parity, etc.
        try {
            // Load the SerialPort class
            Class<?> SerialPortClass = Class.forName("android_serialport_api.SerialPort");
            
            // Get the constructor that takes a File and baudrate
            java.lang.reflect.Constructor<?> constructor = SerialPortClass.getConstructor(
                    File.class, int.class, int.class);
            
            // Create the SerialPort instance with the parameters
            // DATA_BITS, STOP_BITS and PARITY are combined into the 'flags' parameter
            // Format is typically: (DATABITS_8 | STOPBITS_1 | PARITY_MARK)
            int flags = (DATA_BITS | (STOP_BITS << 8) | (PARITY_MARK << 16));
            serialPort = constructor.newInstance(device, BAUD_RATE, flags);
            
            // Get the input and output streams
            Method getInputStreamMethod = SerialPortClass.getMethod("getInputStream");
            Method getOutputStreamMethod = SerialPortClass.getMethod("getOutputStream");
            
            inputStream = (InputStream) getInputStreamMethod.invoke(serialPort);
            outputStream = (OutputStream) getOutputStreamMethod.invoke(serialPort);
            
            Log.d(TAG, "Serial port opened with params: " + BAUD_RATE + " baud, " + 
                  DATA_BITS + " data bits, " + STOP_BITS + " stop bits, MARK parity");
        } catch (Exception e) {
            Log.e(TAG, "Error with serial port API, falling back to basic file I/O", e);
            
            // Fallback: Use basic file I/O (note: this won't configure baud rate, parity, etc.)
            // This is less ideal, as we can't set the serial parameters properly
            try {
                // Try various serial port configuration options - RS232 can be finicky
                
                // Option 1: 9600 baud, 8N1 with mark parity (parenb parmrk)
                String sttyCommand1 = "stty -F " + SERIAL_PORT_PATH + " " + 
                        BAUD_RATE + " cs8 -cstopb parenb parmrk -crtscts -ixon -ixoff raw";
                
                // Option 2: Same but with odd parity instead of mark (some devices interpret them similarly)
                String sttyCommand2 = "stty -F " + SERIAL_PORT_PATH + " " + 
                        BAUD_RATE + " cs8 -cstopb parenb parodd -crtscts -ixon -ixoff raw";
                        
                // Option 3: Try without any parity settings (some devices auto-detect)
                String sttyCommand3 = "stty -F " + SERIAL_PORT_PATH + " " + 
                        BAUD_RATE + " cs8 -cstopb -parenb -crtscts -ixon -ixoff raw";
                
                // Try all options
                Log.d(TAG, "Trying multiple serial configuration options");
                
                Process process1 = Runtime.getRuntime().exec(sttyCommand1);
                int result1 = process1.waitFor();
                Log.d(TAG, "Config option 1 result: " + result1);
                
                Process process2 = Runtime.getRuntime().exec(sttyCommand2);
                int result2 = process2.waitFor();
                Log.d(TAG, "Config option 2 result: " + result2);
                
                Process process3 = Runtime.getRuntime().exec(sttyCommand3);
                int result3 = process3.waitFor();
                Log.d(TAG, "Config option 3 result: " + result3);
                
                // Use the process and result from the last attempt for compatibility with rest of code
                Process process = process3;
                int result = result3;
                
                // Read any error output
                StringBuilder errorOutput = new StringBuilder();
                try (java.io.BufferedReader reader = new java.io.BufferedReader(
                        new java.io.InputStreamReader(process.getErrorStream()))) {
                    String line;
                    while ((line = reader.readLine()) != null) {
                        errorOutput.append(line).append("\n");
                    }
                }
                
                if (result != 0 || errorOutput.length() > 0) {
                    Log.w(TAG, "stty command result: " + result + ", error: " + errorOutput);
                } else {
                    Log.d(TAG, "Successfully configured serial port parameters");
                }
                
                // Open streams using reflection to avoid direct file access restrictions
                Class<?> FileInputStreamClass = Class.forName("java.io.FileInputStream");
                Class<?> FileOutputStreamClass = Class.forName("java.io.FileOutputStream");
                
                java.lang.reflect.Constructor<?> fisConstructor = 
                        FileInputStreamClass.getConstructor(File.class);
                java.lang.reflect.Constructor<?> fosConstructor = 
                        FileOutputStreamClass.getConstructor(File.class);
                
                inputStream = (InputStream) fisConstructor.newInstance(device);
                outputStream = (OutputStream) fosConstructor.newInstance(device);
                
                Log.d(TAG, "Using basic file I/O for serial port");
            } catch (Exception ex) {
                Log.e(TAG, "Failed to set serial parameters via stty", ex);
                throw new IOException("Cannot configure serial port parameters");
            }
        }
        
        // Start the reader thread to handle incoming data
        portReader = new SerialPortReader();
        readerRunning = true;
        executor.submit(portReader);
        
        isConnected = true;
        if (listener != null) {
            listener.onConnectionEstablished();
        }
        
        Log.d(TAG, "Serial connection established with Gryphon at " + SERIAL_PORT_PATH);
        return true;
    } catch (Exception e) {
        Log.e(TAG, "Error opening serial connection", e);
        if (listener != null) {
            listener.onError(e);
        }
        closeConnection();
        return false;
    }
}

/**
 * Close the serial connection and cleanup resources
 */
public void closeConnection() {
    isConnected = false;
    readerRunning = false;
    
    try {
        if (inputStream != null) {
            inputStream.close();
            inputStream = null;
        }
    } catch (IOException e) {
        Log.e(TAG, "Error closing input stream", e);
    }
    
    try {
        if (outputStream != null) {
            outputStream.close();
            outputStream = null;
        }
    } catch (IOException e) {
        Log.e(TAG, "Error closing output stream", e);
    }
    
    // Close the serial port if using the SerialPort API
    if (serialPort != null) {
        try {
            // Use reflection to call the close method
            Method closeMethod = serialPort.getClass().getMethod("close");
            closeMethod.invoke(serialPort);
        } catch (Exception e) {
            Log.e(TAG, "Error closing serial port", e);
        }
        serialPort = null;
    }
    
    Log.d(TAG, "Serial connection closed");
}

public boolean isConnected() {
    return isConnected;
}

/**
 * Send data to the Gryphon device
 * @param data byte array to send
 * @return true if data was sent successfully
 */
public boolean sendData(byte[] data) {
    if (!isConnected || outputStream == null) {
        Log.e(TAG, "Cannot send data. Device not connected.");
        return false;
    }
    
    Log.d(TAG, "Sending data: " + bytesToHexString(data));
    boolean success = false;
    
    try {
        // Try multiple methods to maximize the chance of successful communication
        
        // 1. Clear any pending input first
        try {
            if (inputStream != null && inputStream.available() > 0) {
                byte[] buffer = new byte[inputStream.available()];
                int bytesRead = inputStream.read(buffer);
                if (bytesRead > 0) {
                    Log.d(TAG, "Cleared input buffer: " + bytesToHexString(buffer));
                }
            }
        } catch (IOException e) {
            Log.w(TAG, "Error clearing input buffer: " + e.getMessage());
        }
        
        // 2. Method 1: Try using terminal command
        try {
            StringBuilder hexCmd = new StringBuilder();
            for (byte b : data) {
                hexCmd.append(String.format("\\x%02X", b));
            }
            
            // Try with regular permissions
            String command = "echo -n -e \"" + hexCmd + "\" > " + SERIAL_PORT_PATH;
            Process process = Runtime.getRuntime().exec(command);
            int result = process.waitFor();
            
            if (result == 0) {
                Log.d(TAG, "Data sent via terminal command");
                success = true;
            }
        } catch (Exception e) {
            Log.w(TAG, "Terminal command send failed: " + e.getMessage());
            // Continue to try other methods
        }
        
        // 3. Method 2: Try with root (for rooted devices)
        if (!success) {
            try {
                StringBuilder hexCmd = new StringBuilder();
                for (byte b : data) {
                    hexCmd.append(String.format("\\x%02X", b));
                                listener.onReceiveData(data);
                            }
                        }
                    }
                    
                    // Sleep to avoid high CPU usage
                    Thread.sleep(10);
                } catch (Exception e) {
                    Log.e(TAG, "Error reading from serial port", e);
                    if (listener != null) {
                        listener.onError(e);
                        listener.onConnectionLost();
                    }
                    isConnected = false;
                    readerRunning = false;
                    break;
                }
            }
        }
    }

    /**
     * Clean up resources when the app is closing
     */
    public void destroy() {
        closeConnection();
        executor.shutdownNow();
    }
}
